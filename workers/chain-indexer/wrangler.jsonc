{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eunomia-chain-indexer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // stellar-base decodes XDR with Buffer
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/15 * * * *"] },
  // cron only: no public URL
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The empty values are set at deploy, once the registry exists; until then every run fails
  // with a message saying so.
  "vars": {
    "NETWORK": "mainnet",
    // as the app's EUNOMIA_REGISTRY_ID
    "REGISTRY_ID": ""
  }
  // secrets (wrangler secret put …): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and RPC_URL —
  // the provider the app's worker holds as RELAY_RPC_URL; its URL carries the account key,
  // so it is never a var.
}
